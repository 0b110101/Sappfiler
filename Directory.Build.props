<Project>

  <!--
    全仓库统一的版本号定义。
    MSBuild 会自动向上查找本文件并应用到 src/ 与 tests/ 下的所有工程，
    所以改动版本号只需改这一处。

    命名规则：v0.9.5-alphaNN 为「尚未正式发布」的预发布版本（alpha17、alpha18、…）。
    正式发布（v1.0.0）前，把 VersionPrefix 改为 1.0.0 并去掉 VersionSuffix。

    - VersionPrefix / VersionSuffix  -> AssemblyInformationalVersion（程序里读到的可读版本）
    - FileVersion                    -> exe 文件属性「文件版本」（Windows 要求每段为 0-65535，故不含预发布后缀）
    - AssemblyVersion                -> 程序集绑定版本，只在大版本变动时改

    ⚠️ 给 QA 出新包时**必须同时改这三行**（alpha 序号 + FileVersion 第三段 + 必要时 Product 之类），
    只改 VersionSuffix 会让 exe 的文件属性仍显示旧版本，QA 无法从属性对话框分辨包的新旧。
    对应地，Package.appxmanifest 里的 Version 也要跟着改。
  -->
  <PropertyGroup>
    <VersionPrefix>0.9.5</VersionPrefix>
    <VersionSuffix>alpha21</VersionSuffix>

    <FileVersion>0.9.5.21</FileVersion>
    <AssemblyVersion>0.9.5.0</AssemblyVersion>

    <Product>GameTimeTracker</Product>
    <Company>GameTimeTracker</Company>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

</Project>
