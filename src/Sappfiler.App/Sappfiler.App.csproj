<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sappfiler</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GameTimeTracker.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">false</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\achievements_completed.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />

    <!--
      ⚠️ 刻意**不引用** Microsoft.WindowsAppSDK 元包，改为只引用需要的子包。

      元包本身是纯聚合包（build/*.targets 是空的，props 只声明 VS 的 ProjectCapability），
      但它会连带拉进 4 个本程序完全用不到的组件：

        Microsoft.WindowsAppSDK.AI       → 14 个 dll（AiFabric / AICapabilities / ContentSafety…）
                                        → 还传递依赖 microsoft.windows.ai.machinelearning
                                          带来 onnxruntime.dll(20.7MB) + DirectML.dll(17.8MB)
        Microsoft.WindowsAppSDK.ML       → ML 包装层
        Microsoft.WindowsAppSDK.Search   → Microsoft.Windows.Search.dll(3.3MB)
        Microsoft.WindowsAppSDK.Widgets  → Microsoft.Windows.Widgets.dll(2.4MB)

      合计约 55MB（发布包 285MB 的 19%，zip 约省 20MB）。
      本程序不做 AI/ML、不接 Windows 搜索、不挂小组件，这些文件在包里纯属浪费。

      版本号取自元包 2.5.1 的 nuspec 依赖清单，与其完全一致，避免版本漂移。

      ⚠️ 改这里**必须实际构建 + 启动验证**：少引一个子包会导致
         Microsoft.UI.Xaml.dll / WindowsAppRuntime.Bootstrap.dll 等缺失。
         publish.ps1 的「产物校验」会拦住这类明显的缺失（见该脚本第 4b 节）。

      🚨 **2026-09-19 事故：这个"瘦身"曾让程序一启动就崩，已回退。**
        症状：`XamlParseException: Cannot locate resource from
        'ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml'`，
        进程 1 秒内以 0xC000027B 退出。

        原因：改成子包引用后，**应用 PRI 不再合并框架的 PRI**。
        对比同一次发布的 `GameTimeTracker.App.pri`：
          · 用元包  → 2,227,184 字节（已合并 WinUI 的 Themes/themeresources.xaml）
          · 用子包  →    43,464 字节（只剩本程序自己的资源）→ 主题资源找不到 → 崩

        阴险之处：这个 bug **被增量构建掩盖了很久**。旧的合并版 PRI 一直留在
        bin/ 里被沿用，所以 alpha18~alpha22 的包都是好的；直到某次全新编译
        （dotnet build 加 no-incremental）才按"未合并"重新生成 → 立刻暴露。

        → **省这 55MB 不值得**，恢复元包引用。若将来还想瘦身，必须验证
          `GameTimeTracker.App.pri` 仍在 2MB 量级，并且真的能启动。
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />

    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sappfiler.Core\Sappfiler.Core.csproj" />
    <ProjectReference Include="..\Sappfiler.Infrastructure\Sappfiler.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Publish Properties

    ⚠️ PublishTrimmed 必须保持 false。WinUI 3 **不支持裁剪**：
    XAML 的数据绑定、{x:Bind}、资源查找、WinRT 投影全都靠反射按名字解析类型，
    裁剪器静态分析看不到这些引用，会把 Microsoft.UI.Xaml.* 等 native 实现
    和 *.Projection.dll 一起删掉。

    实测症状（2026-09-18）：Release 发布后程序一启动就崩，
    日志里是 WinRT 投影层的 NullReferenceException：
        at WinRT.TypeExtensions.GetAbiToProjectionVftblPtr(Type helperType)
        at ABI.Microsoft.UI.Xaml.Controls.IItemsRepeaterMethods.set_ItemsSource(...)
        at HomePage.HomePage_obj1_Bindings.Update_ViewModel(...)
    产物对比：裁剪后 101 文件 / 86MB（Microsoft.UI.Xaml.dll 等全缺），
    不裁剪 449 文件 / 285MB（正常）。

    之前这里写的是 `Configuration != Debug → True`，是个藏了很久的地雷：
    只要有人用 Release 发布就会产出必崩的包。已改为恒定 false。
  -->
  <PropertyGroup>
    <!--
      ⚠️ ReadyToRun 必须**恒定关闭**（2026-09-19 实测确认，别再改回条件式）。

      开着 R2R 发布时，「关掉界面 → 从托盘打开」会稳定崩溃：
        出错模块 CoreMessagingXP.dll
        异常码   0xc000027b (STATUS_STOWED_EXCEPTION)
        WER 签名 combase.dll / 80004005 (E_FAIL)
      而且日志里一行都没有 —— 这是原生层崩溃，
      Application.UnhandledException 和 AppDomain.UnhandledException 都拦不到。

      同一份代码只改这一个开关的对照实验（其余参数完全相同）：
        R2R 开启 → 1~3 轮之内必崩
        R2R 关闭 → 连续 4~6 轮全部正常

      机理与上面 PublishTrimmed 那次同源：WinRT 投影层要在**首次访问类型**时
      去解析 ABI vftbl 指针（WinRT.TypeExtensions.GetAbiToProjectionVftblPtr）。
      R2R 把一部分投影代码预编译、固化了调用点，而本程序会把界面树整个释放、
      之后按需重建（收进托盘省内存的那套逻辑）—— 重建时类型初始化顺序一变，
      就会踩到已失效的指针。

      代价：冷启动多一次 JIT，略慢一点点，换稳定，值得。
    -->
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>

    <!--
      只保留中/英文的本地化资源。

      WinUI 的 native 库（Microsoft.ui.xaml.dll 等）会带 86 个语言的 .mui 卫星资源，
      默认全部复制进发布目录 —— 于是包根目录多出 86 个语言文件夹（共约 3.7MB）。
      它们只提供 WinUI **内部**字符串（主要是 XAML 报错信息）的本地化，
      与本程序的界面无关（界面文案是硬编码中文，走 GameTimeTracker.App.pri）。

      裁掉后不影响功能：Windows 的 MUI 机制找不到对应语言时会回退到
      DLL 内嵌的英文中性资源。所以非中英文 Windows 上，WinUI 内部报错会显示英文。

      ⚠️ 顶层的 .pri 文件（GameTimeTracker.App.pri / Microsoft.UI.Xaml.Controls.pri /
         Microsoft.WindowsAppRuntime.pri）是**必需的应用资源，绝不能删**。
         本属性只影响 .mui 卫星资源，不会碰 .pri。
    -->
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>