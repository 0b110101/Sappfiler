<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameTimeTracker.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="应用程序设置" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="配置 Notion API 凭证、数据库 ID 以及监控轮询参数" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Test Connection InfoBar -->
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Appearance & System Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="系统与外观" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />

                    <!-- 开机自启动 (默认关闭) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="开机自启动" FontSize="15" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="开机登录后自动在后台托盘静默运行，无需手动启动（默认关闭）" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" Toggled="OnAutoStartToggled" OnContent="已开启" OffContent="已关闭" />
                    </Grid>

                    <Border Background="{ThemeResource CardBorderBrush}" Opacity="0.35" Height="1" />

                    <!-- 深色模式 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="深色模式 (Dark Theme)" FontSize="15" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="切换专属深色星空主题" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ThemeToggle" Grid.Column="1" Toggled="OnThemeToggled" OnContent="已开启" OffContent="已关闭" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notion Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Notion 同步配置" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="通过 Notion API 将游戏时长与游戏总表同步至云端" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NotionEnabledToggle" Grid.Column="1" Toggled="OnNotionEnabledToggled" OnContent="已开启" OffContent="已关闭" />
                    </Grid>

                    <Border Background="{ThemeResource CardBorderBrush}" Opacity="0.35" Height="1" />

                    <PasswordBox x:Name="TokenInput" Header="Notion Token" PlaceholderText="secret_xxxxxxxxxxxxxxxx"
                                 MaxWidth="520" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="GameDbInput" Header="游戏总表 Database ID" PlaceholderText="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                             MaxWidth="520" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="DailyDbInput" Header="每日时长表 Database ID" PlaceholderText="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                             MaxWidth="520" HorizontalAlignment="Stretch" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="SaveBtn" Click="OnSaveClicked" Content="保存 Notion 设置" CornerRadius="8" Background="{ThemeResource AccentBlueBrush}" Foreground="White" Padding="16,8" />
                        <Button x:Name="TestBtn" Click="OnTestConnectionClicked" Content="测试连接" CornerRadius="8" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Obsidian Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Obsidian 同步配置" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="将每日时长与游戏笔记同步至 Obsidian Vault，支持原子写入与标记区间保护" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ObsidianEnabledToggle" Grid.Column="1" Toggled="OnObsidianEnabledToggled" OnContent="已开启" OffContent="已关闭" />
                    </Grid>

                    <Border Background="{ThemeResource CardBorderBrush}" Opacity="0.35" Height="1" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="同步模式" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <ComboBox x:Name="ObsidianModeCombo" MinWidth="320" SelectionChanged="OnObsidianModeChanged">
                            <ComboBoxItem Content="文件直写模式（直接读写 Vault 目录，推荐）" Tag="file" />
                            <ComboBoxItem Content="Local REST API 插件模式（通过本地 HTTP API）" Tag="api" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 文件模式专属: Vault 路径 -->
                    <StackPanel x:Name="ObsidianFilePanel" Spacing="8">
                        <TextBlock Text="Vault 根目录路径" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ObsidianVaultInput" PlaceholderText="例如: D:\Obsidian\MyVault"
                                     HorizontalAlignment="Stretch" />
                            <Button x:Name="BrowseVaultBtn" Grid.Column="1" Content="浏览…" CornerRadius="8" Padding="14,6"
                                    Margin="12,0,0,0" Click="OnBrowseVaultClicked" />
                        </Grid>
                    </StackPanel>

                    <!-- API 模式专属: 端口与 Key -->
                    <StackPanel x:Name="ObsidianApiPanel" Spacing="12" Visibility="Collapsed">
                        <TextBox x:Name="ObsidianPortInput" Header="API 端口" PlaceholderText="27124"
                                 MaxWidth="520" HorizontalAlignment="Stretch" />
                        <PasswordBox x:Name="ObsidianKeyInput" Header="API Key" PlaceholderText="插件生成的 API Key"
                                     MaxWidth="520" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- 通用子目录设置 -->
                    <TextBox x:Name="ObsidianDailyFolderInput" Header="日报保存子路径" PlaceholderText="Sappfiler/Daily"
                             MaxWidth="520" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="ObsidianGamesFolderInput" Header="游戏笔记保存子路径" PlaceholderText="Sappfiler/Games"
                             MaxWidth="520" HorizontalAlignment="Stretch" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="SaveObsidianBtn" Click="OnSaveObsidianClicked" Content="保存 Obsidian 设置" CornerRadius="8" Background="{ThemeResource AccentBlueBrush}" Foreground="White" Padding="16,8" />
                        <Button x:Name="TestObsidianBtn" Click="OnTestObsidianClicked" Content="测试连接" CornerRadius="8" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 思源笔记 (SiYuan) Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="思源笔记 (SiYuan) 同步配置" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="通过官方本地内核 API 将游戏时长与游戏文档同步至思源笔记本" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SiYuanEnabledToggle" Grid.Column="1" Toggled="OnSiYuanEnabledToggled" OnContent="已开启" OffContent="已关闭" />
                    </Grid>

                    <Border Background="{ThemeResource CardBorderBrush}" Opacity="0.35" Height="1" />

                    <TextBox x:Name="SiYuanEndpointInput" Header="API 地址" PlaceholderText="http://127.0.0.1:6806"
                             MaxWidth="520" HorizontalAlignment="Stretch" />
                    <PasswordBox x:Name="SiYuanTokenInput" Header="API Token (设置 → 关于 → API Token，无则留空)"
                                 MaxWidth="520" HorizontalAlignment="Stretch" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="目标笔记本" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SiYuanNotebookCombo" PlaceholderText="请选择或输入笔记本 ID"
                                      HorizontalAlignment="Stretch" IsEditable="True" />
                            <Button x:Name="FetchNotebooksBtn" Grid.Column="1" Content="刷新列表" CornerRadius="8" Padding="14,6"
                                    Margin="12,0,0,0" Click="OnFetchNotebooksClicked" />
                        </Grid>
                    </StackPanel>

                    <TextBox x:Name="SiYuanMasterDbInput" Header="游戏总表数据库 Block ID (推荐)" PlaceholderText="输入思源游戏总表数据库 Block ID（支持原生 Rollup 自动汇总总时长）"
                             MaxWidth="520" HorizontalAlignment="Stretch" />

                    <TextBox x:Name="SiYuanDailyDbInput" Header="每日打卡数据库 Block ID (推荐)" PlaceholderText="输入思源每日时长打卡数据库 Block ID（支持关联游戏总表打卡）"
                             MaxWidth="520" HorizontalAlignment="Stretch" />

                    <TextBox x:Name="SiYuanRootPathInput" Header="根文档路径 (文档模式备用)" PlaceholderText="/Sappfiler"
                             MaxWidth="520" HorizontalAlignment="Stretch" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="SaveSiYuanBtn" Click="OnSaveSiYuanClicked" Content="保存思源设置" CornerRadius="8" Background="{ThemeResource AccentBlueBrush}" Foreground="White" Padding="16,8" />
                        <Button x:Name="TestSiYuanBtn" Click="OnTestSiYuanClicked" Content="测试连接" CornerRadius="8" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notion Title Normalization Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="Notion 历史数据格式规范化" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="一键扫描 Notion 每日时长表中的历史记录，将记录标题统一规范化为「游戏名 · 时长 h」标准格式，并对齐总表游戏名与页面图标。安全承诺：仅更新标题与图标，绝不修改时长数值或日期，未关联总表的记录安全跳过。"
                               FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="NormalizeTitlesBtn" Click="OnNormalizeTitlesClicked" Content="开始格式规范化" CornerRadius="8" Padding="16,8" />
                        <ProgressBar x:Name="NormalizeProgressBar" Width="200" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="NormalizeStatusText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Daily Cutoff Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="跨日时间戳设置" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="设定每日游戏时长的归属结算点。适合习惯深夜游玩的用户，避免凌晨游戏记录被割裂到次日。"
                               FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="每日跨日结算时间点 (整点)" FontSize="15" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="在该时刻之前游玩的时间均归属于前一日" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="CutoffHourCombo" Grid.Column="1" MinWidth="220" SelectionChanged="OnCutoffHourChanged">
                            <ComboBoxItem Content="24:00 (次日 00:00 - 标准跨日)" Tag="24" />
                            <ComboBoxItem Content="25:00 (次日 01:00)" Tag="25" />
                            <ComboBoxItem Content="26:00 (次日 02:00)" Tag="26" />
                            <ComboBoxItem Content="27:00 (次日 03:00)" Tag="27" />
                            <ComboBoxItem Content="28:00 (次日 04:00 - 深夜玩家推荐)" Tag="28" />
                            <ComboBoxItem Content="29:00 (次日 05:00)" Tag="29" />
                            <ComboBoxItem Content="30:00 (次日 06:00)" Tag="30" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tracker Performance Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="后台监控与同步策略" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="进程轮询心跳: 5 秒 (极低 CPU 消耗)" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="Notion 同步策略: 应用启动时自动同步、游戏退出时自动同步 (无游戏时不空转轮询)" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="本地数据库: SQLite WAL 高性能模式" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="系统托盘: 点击右上角 × 关闭按钮自动最小化至托盘" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Storage Location Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="存档位置" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="数据库与封面缓存的存放位置。更改后自动把现有数据复制到新位置，重启程序生效。" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Border Background="{ThemeResource CardBorderBrush}" Opacity="0.35" Height="1" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StoragePathText" Grid.Column="0" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Consolas" />
                        <Button x:Name="ChangeStorageBtn" Grid.Column="1" Content="更改…" CornerRadius="8" Padding="14,6"
                                Margin="12,0,0,0" Click="OnChangeStorageClicked" />
                        <Button x:Name="ResetStorageBtn" Grid.Column="2" Content="恢复默认" CornerRadius="8" Padding="14,6"
                                Margin="8,0,0,0" Click="OnResetStorageClicked" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Version footer -->
            <TextBlock x:Name="VersionText"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,8"
                       FontSize="12"
                       Foreground="{ThemeResource TextSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
