<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameTimeTracker.App.Views.PendingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GameTimeTracker.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="待处理游戏队列" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="检测到的新游戏已自动在本地开始计时。在此处确认绑定到 Notion 游戏总表，绑定后自动同步历史记录" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Feedback InfoBar -->
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" Margin="0,0,0,4" />

            <!-- Info Bar when empty -->
            <Border x:Name="EmptyNotice" Visibility="Collapsed" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource StatusGreenBrush}" />
                    <TextBlock Text="太棒了！所有检测到的游戏均已完成 Notion 绑定，暂无待处理项。" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Pending Games ItemsRepeater -->
            <ItemsRepeater x:Name="PendingRepeater">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:GameRecord">
                        <Border Margin="0,0,0,12" CornerRadius="12"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundBrush}"
                                Padding="18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 封面容器不留底色/描边，圆角只用于裁切 -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource StringToImageConverter}}"
                                               Stretch="UniformToFill"
                                               Visibility="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource NullToVisConverter}}" />
                                         <Viewbox Width="24" Height="24" Visibility="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource InverseNullToVisConverter}}">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{ThemeResource AccentBlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M 8 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 14 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 15.5 17 c 0 1 1.5 3 2 3 c 1.5 0 2.833 -1.667 3.5 -3 c 0.667 -1.667 0.5 -5.833 -1.5 -11.5 c -1.457 -1.015 -3 -1.34 -4.5 -1.5 l -0.972 1.923 a 11.913 11.913 0 0 0 -4.053 0 l -0.975 -1.923 c -1.5 0.16 -3.043 0.485 -4.5 1.5 c -2 5.667 -2.167 9.833 -1.5 11.5 c 0.667 1.333 2 3 3.5 3 c 0.5 0 2 -2 2 -3 M 7 16.5 c 3.5 1 6.5 1 10 0" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <Border Background="#154F8FFF" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{x:Bind Platform}" FontSize="12" Foreground="{ThemeResource AccentBlueBrush}" FontWeight="Medium" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ExecutablePath}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Tag="{x:Bind}" Click="OnBindGameClicked" Background="{ThemeResource AccentBlueBrush}" Foreground="White" CornerRadius="8" Padding="12,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE71B;" FontSize="12" />
                                            <TextBlock Text="绑定到 Notion" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="{x:Bind}" Click="OnIgnoreGameClicked" CornerRadius="8" Padding="10,6">
                                        <TextBlock Text="忽略" FontSize="13" />
                                    </Button>
                                    <Button Tag="{x:Bind}" Click="OnDeleteGameClicked" CornerRadius="8" Padding="10,6" Foreground="{ThemeResource StatusRedBrush}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Ignored Games Section (反悔药) -->
            <StackPanel x:Name="IgnoredSection" Spacing="10" Margin="0,16,0,0" Visibility="Collapsed">
                <Button x:Name="ToggleIgnoredBtn" Click="OnToggleIgnoredClicked" Background="Transparent" BorderThickness="0" Padding="4,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="IgnoredChevronIcon" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="IgnoredTitleText" Text="已忽略的游戏 (0)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <ItemsRepeater x:Name="IgnoredRepeater" Visibility="Collapsed">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:GameRecord">
                            <Border Margin="0,0,0,8" CornerRadius="10"
                                    BorderBrush="{ThemeResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundBrush}"
                                    Opacity="0.85"
                                    Padding="14,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <Border Background="#154F8FFF" CornerRadius="4" Padding="4,1">
                                                <TextBlock Text="{x:Bind Platform}" FontSize="11" Foreground="{ThemeResource AccentBlueBrush}" />
                                            </Border>
                                            <Border Background="#15888888" CornerRadius="4" Padding="4,1">
                                                <TextBlock Text="已忽略" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ExecutablePath}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Tag="{x:Bind}" Click="OnRestoreGameClicked" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                            <TextBlock Text="恢复到待处理" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
