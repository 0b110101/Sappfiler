<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameTimeTracker.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:GameTimeTracker.App.Controls"
    xmlns:vm="using:GameTimeTracker.App.ViewModels"
    mc:Ignorable="d">

    <!-- ⚠️ HorizontalScrollMode="Disabled" 不能省。
         ScrollViewer 的 BarVisibility 与 ScrollMode 是两个独立开关：只写
         BarVisibility="Disabled" 时滚动条确实不出现，但 ScrollMode 仍是默认的
         Enabled → CanHorizontallyScroll=true → **测量子元素时给的是无限宽**。
         于是热力图那 52 周 × 16px = 832px 的内容会把这个 Grid 撑到 ~1250px，
         再叠加上下面的窄/宽布局判定（< 880 才切窄），就会在"热力图数据加载出来"的
         瞬间把右列甩到屏幕外 —— 表现为"数据一多，右边的区块就掉了"。
         见 2026-09-19 用户反馈的截图。 -->
    <ScrollViewer x:Name="RootScroll"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled" VerticalScrollMode="Enabled"
                  SizeChanged="OnRootGridSizeChanged">
        <Grid x:Name="RootContentGrid" Padding="24,16,24,24" ColumnSpacing="20" RowSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="*" MinWidth="0" />
                <ColumnDefinition x:Name="ColRight" Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="RowRight" Height="0" />
            </Grid.RowDefinitions>

            <!-- ================= Left Main Column ================= -->
            <StackPanel x:Name="LeftPanel" Grid.Column="0" Spacing="16">

                <!-- 1. Current Game Hero Card -->
                <Border CornerRadius="16"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        Padding="0"
                        PointerEntered="OnHeroCardPointerEntered"
                        PointerExited="OnHeroCardPointerExited">
                    <Grid x:Name="HeroCardContentGrid" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="HeroCardScale" ScaleX="1.0" ScaleY="1.0" />
                        </Grid.RenderTransform>
                        <!-- Ambient Cover Background (when Notion cover exists)
                             用 ImageBrush 而非 Image：Image 参与布局测量，cover 原图会把卡片撑大；
                             画刷只负责绘制、不参与测量（外层 Border desired size = 0），
                             卡片尺寸完全由内容决定 —— 有图无图尺寸一致。 -->
                        <Border CornerRadius="16"
                                Visibility="{x:Bind ViewModel.CurrentGameHeroBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVisConverter}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind ViewModel.CurrentGameHeroBackgroundUrl, Mode=OneWay, Converter={StaticResource StringToImageConverter}}"
                                            Stretch="UniformToFill"
                                            Opacity="0.30"
                                            AlignmentX="Center" AlignmentY="Center" />
                            </Border.Background>
                        </Border>

                        <!-- Subtle overlay tint to keep card readable. -->
                        <Border Background="{ThemeResource CardBackgroundBrush}" Opacity="0.18"
                                Visibility="{x:Bind ViewModel.CurrentGameHeroBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVisConverter}}" />

                        <Grid Padding="22">
                            <!-- When Game Is Running -->
                            <Grid Visibility="{x:Bind ViewModel.IsGameRunning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Cover Image / Icon
                                     容器不再给底色与描边：图标 PNG 自带透明边距时会露出深色底，
                                     看上去就是给每张封面套了个黑色圆角框。只保留圆角用于裁切。 -->
                                <Border Grid.Column="0" Width="88" Height="88" CornerRadius="12" Margin="0,0,18,0">
                                    <Grid>
                                        <Image Source="{x:Bind ViewModel.CurrentGameCoverPath, Mode=OneWay, Converter={StaticResource StringToImageConverter}}"
                                               Stretch="UniformToFill"
                                               Visibility="{x:Bind ViewModel.CurrentGameCoverPath, Mode=OneWay, Converter={StaticResource NullToVisConverter}}" />
                                        <Viewbox Width="36" Height="36" Visibility="{x:Bind ViewModel.CurrentGameCoverPath, Mode=OneWay, Converter={StaticResource InverseNullToVisConverter}}">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{ThemeResource AccentBlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M 8 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 14 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 15.5 17 c 0 1 1.5 3 2 3 c 1.5 0 2.833 -1.667 3.5 -3 c 0.667 -1.667 0.5 -5.833 -1.5 -11.5 c -1.457 -1.015 -3 -1.34 -4.5 -1.5 l -0.972 1.923 a 11.913 11.913 0 0 0 -4.053 0 l -0.975 -1.923 c -1.5 0.16 -3.043 0.485 -4.5 1.5 c -2 5.667 -2.167 9.833 -1.5 11.5 c 0.667 1.333 2 3 3.5 3 c 0.5 0 2 -2 2 -3 M 7 16.5 c 3.5 1 6.5 1 10 0" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <Border Background="#1534D399" BorderBrush="{ThemeResource StatusGreenBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="● 正在游玩" FontSize="12" Foreground="{ThemeResource StatusGreenBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <controls:MarqueeTextBlock Text="{x:Bind ViewModel.CurrentGameTitle, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentGameSubtitle, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <FontIcon Glyph="&#xE916;" FontSize="16" Foreground="{ThemeResource AccentBlueBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentGameTimer, Mode=OneWay}" FontSize="24" FontWeight="Bold" FontFamily="Consolas" Foreground="{ThemeResource AccentBlueBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Platform Pill：Steam 游戏时整块可点，跳转对应商店页
                                     HyperlinkButton 自带手型光标与悬停反馈；其它平台仍用静态 Border -->
                                <Grid Grid.Column="2" VerticalAlignment="Top">
                                    <HyperlinkButton Click="OnOpenStoreClicked"
                                                     Visibility="{x:Bind ViewModel.CurrentGameStoreUrl, Mode=OneWay, Converter={StaticResource NullToVisConverter}}"
                                                     Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="12"
                                                     ToolTipService.ToolTip="在 Steam 商店中打开">
                                        <Border Background="#154F8FFF" BorderBrush="{ThemeResource AccentBlueBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="{ThemeResource AccentBlueBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.CurrentGameTag, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AccentBlueBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </HyperlinkButton>

                                    <Border Visibility="{x:Bind ViewModel.CurrentGameStoreUrl, Mode=OneWay, Converter={StaticResource InverseNullToVisConverter}}"
                                            Background="#154F8FFF" BorderBrush="{ThemeResource AccentBlueBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="{ThemeResource AccentBlueBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentGameTag, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AccentBlueBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- When Idle -->
                            <Grid Visibility="{x:Bind ViewModel.IsGameRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVisConverter}}" Padding="8">
                                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                     <Border Width="64" Height="64" CornerRadius="12" Background="#154F8FFF">
                                        <Viewbox Width="30" Height="30">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{ThemeResource AccentBlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M 8 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 14 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 15.5 17 c 0 1 1.5 3 2 3 c 1.5 0 2.833 -1.667 3.5 -3 c 0.667 -1.667 0.5 -5.833 -1.5 -11.5 c -1.457 -1.015 -3 -1.34 -4.5 -1.5 l -0.972 1.923 a 11.913 11.913 0 0 0 -4.053 0 l -0.975 -1.923 c -1.5 0.16 -3.043 0.485 -4.5 1.5 c -2 5.667 -2.167 9.833 -1.5 11.5 c 0.667 1.333 2 3 3.5 3 c 0.5 0 2 -2 2 -3 M 7 16.5 c 3.5 1 6.5 1 10 0" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <Border Background="#158B8FA3" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="● 空闲中" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="暂无运行中的游戏" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="后台持续自动监听 Steam / Epic / Xbox 平台游戏" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Metric Cards (Today & Week) - Figure 1 Layout -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Today Card -->
                    <Border Grid.Column="0" CornerRadius="14"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundBrush}"
                            Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Circular Icon Badge -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#154F8FFF" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Viewbox Width="30" Height="30">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource AccentBlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 4 7 a 2 2 0 0 1 2 -2 h 12 a 2 2 0 0 1 2 2 v 12 a 2 2 0 0 1 -2 2 h -12 a 2 2 0 0 1 -2 -2 v -12 z M 16 3 v 4 M 8 3 v 4 M 4 11 h 16 M 7 14 h 0.013 M 10.01 14 h 0.005 M 13.01 14 h 0.005 M 16.015 14 h 0.005 M 13.015 17 h 0.005 M 7.01 17 h 0.005 M 10.01 17 h 0.005" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- Center: Title & Duration -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="今日总计" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="Medium" />
                                <TextBlock Text="{x:Bind ViewModel.TodayDurationText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Right: Percent & Delta Comparison -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{x:Bind ViewModel.TodayDeltaBrush, Mode=OneWay}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="{x:Bind ViewModel.TodayDeltaIconData, Mode=OneWay}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.TodayDeltaPercentText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.TodayDeltaBrush, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                                <TextBlock Text="较昨日" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Week Card -->
                    <Border Grid.Column="1" CornerRadius="14"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundBrush}"
                            Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Circular Icon Badge -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#154F8FFF" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Viewbox Width="30" Height="30">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource AccentBlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 4 7 a 2 2 0 0 1 2 -2 h 12 a 2 2 0 0 1 2 2 v 12 a 2 2 0 0 1 -2 2 h -12 a 2 2 0 0 1 -2 -2 v -12 z M 16 3 v 4 M 8 3 v 4 M 4 11 h 16 M 7 14 h 0.013 M 10.01 14 h 0.005 M 13.01 14 h 0.005 M 16.015 14 h 0.005 M 13.015 17 h 0.005 M 7.01 17 h 0.005 M 10.01 17 h 0.005" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- Center: Title & Duration -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="本周总计" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="Medium" />
                                <TextBlock Text="{x:Bind ViewModel.WeekDurationText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Right: Percent & Delta Comparison -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{x:Bind ViewModel.WeekDeltaBrush, Mode=OneWay}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="{x:Bind ViewModel.WeekDeltaIconData, Mode=OneWay}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.WeekDeltaPercentText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.WeekDeltaBrush, Mode=OneWay}" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                                <TextBlock Text="较上周" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Heatmap Card (52-Week 1-Year Activity Heatmap) -->
                <Border CornerRadius="14"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <!-- Heatmap Top Bar -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 4 7 a 2 2 0 0 1 2 -2 h 12 a 2 2 0 0 1 2 2 v 12 a 2 2 0 0 1 -2 2 h -12 a 2 2 0 0 1 -2 -2 v -12 z M 16 3 v 4 M 8 3 v 4 M 4 11 h 16 M 7 14 h 0.013 M 10.01 14 h 0.005 M 13.01 14 h 0.005 M 16.015 14 h 0.005 M 13.015 17 h 0.005 M 7.01 17 h 0.005 M 10.01 17 h 0.005" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="游戏热力图" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.HeatmapActiveDaysText, Mode=OneWay}"
                                       FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Dedicated 52-Week Activity Heatmap Component -->
                        <controls:HeatmapControl HeatmapData="{x:Bind ViewModel.ActivityHeatmap, Mode=OneWay}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 4. Recent Records Table -->
                <Border CornerRadius="14"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 3 12 a 9 9 0 1 0 18 0 a 9 9 0 0 0 -18 0 M 12 7 v 5 l 3 3" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="最近记录" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Command="{x:Bind ViewModel.ViewAllHistoryCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="6,2">
                                <TextBlock Text="查看全部 &gt;" FontSize="13" Foreground="{ThemeResource AccentBlueBrush}" FontWeight="Medium" />
                            </Button>
                        </Grid>

                        <!-- Table Header -->
                        <Grid Padding="8,4" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日期" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="游戏" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="时长" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,24,0" />
                            <TextBlock Grid.Column="3" Text="状态" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Table Rows -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentRecords, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentRecordViewModel">
                                    <Grid Padding="8,8" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,0.5">
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="100" />
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="100" />
                                             <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind DateText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0">
                                                 <Grid>
                                                    <Image Source="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill"
                                                           Visibility="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource NullToVisConverter}}" />
                                                    <Viewbox Width="14" Height="14" Visibility="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource InverseNullToVisConverter}}">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  Data="M 8 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 14 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 15.5 17 c 0 1 1.5 3 2 3 c 1.5 0 2.833 -1.667 3.5 -3 c 0.667 -1.667 0.5 -5.833 -1.5 -11.5 c -1.457 -1.015 -3 -1.34 -4.5 -1.5 l -0.972 1.923 a 11.913 11.913 0 0 0 -4.053 0 l -0.975 -1.923 c -1.5 0.16 -3.043 0.485 -4.5 1.5 c -2 5.667 -2.167 9.833 -1.5 11.5 c 0.667 1.333 2 3 3.5 3 c 0.5 0 2 -2 2 -3 M 7 16.5 c 3.5 1 6.5 1 10 0" />
                                                        </Canvas>
                                                    </Viewbox>
                                                 </Grid>
                                            </Border>
                                            <controls:MarqueeTextBlock Grid.Column="1" Text="{x:Bind GameName, Mode=OneWay}" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{x:Bind DurationText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Column 1: Right Dashboard Panel -->
            <StackPanel x:Name="RightPanel" Grid.Column="1" Spacing="16">

                <!-- 1. Compact Notion Sync Status Card -->
                <Border CornerRadius="14"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <!-- Header: Title on Left, Last Sync Timestamp on Right -->
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{x:Bind ViewModel.NotionStatusBrush, Mode=OneWay}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 11 18.004 h -4.343 c -2.572 -0.004 -4.657 -2.011 -4.657 -4.487 c 0 -2.475 2.085 -4.482 4.657 -4.482 c 0.393 -1.762 1.794 -3.2 3.675 -3.773 c 1.88 -0.572 3.956 -0.193 5.444 1 c 1.488 1.19 2.162 3.007 1.77 4.769 h 0.99 c 1.388 0 2.585 0.82 3.138 2.007 M 15 19 l 2 2 l 4 -4" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="同步状态" FontSize="15" FontWeight="Bold" Foreground="{x:Bind ViewModel.NotionStatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.NotionLastSyncText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="150" />
                        </Grid>

                        <!-- Status detail row: Gets full width of card without crowding -->
                        <Grid ColumnSpacing="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{x:Bind ViewModel.NotionStatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NotionStatusText, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.NotionStatusText, Mode=OneWay}" />
                        </Grid>

                        <Button Command="{x:Bind ViewModel.SyncNowCommand}"
                                HorizontalAlignment="Stretch"
                                CornerRadius="8"
                                Padding="12,7"
                                Background="#154F8FFF"
                                BorderBrush="{ThemeResource AccentBlueBrush}"
                                BorderThickness="1">
                            <Grid HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource AccentBlueBrush}" />
                                    <TextBlock Text="立即同步" FontSize="13" Foreground="{ThemeResource AccentBlueBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource AccentBlueBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 2. Today Games Card (Expandable) -->
                <Border CornerRadius="14"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 8 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 14 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 15.5 17 c 0 1 1.5 3 2 3 c 1.5 0 2.833 -1.667 3.5 -3 c 0.667 -1.667 0.5 -5.833 -1.5 -11.5 c -1.457 -1.015 -3 -1.34 -4.5 -1.5 l -0.972 1.923 a 11.913 11.913 0 0 0 -4.053 0 l -0.975 -1.923 c -1.5 0.16 -3.043 0.485 -4.5 1.5 c -2 5.667 -2.167 9.833 -1.5 11.5 c 0.667 1.333 2 3 3.5 3 c 0.5 0 2 -2 2 -3 M 7 16.5 c 3.5 1 6.5 1 10 0" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="今日游戏" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- 仅在超过 3 个游戏时显示展开/收起按钮 -->
                            <Button Command="{x:Bind ViewModel.ToggleTodayGamesCommand}"
                                    Visibility="{x:Bind ViewModel.HasMoreThanThreeTodayGames, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4,2">
                                <TextBlock Text="{x:Bind ViewModel.TodayGamesToggleText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentBlueBrush}" />
                            </Button>
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.TodayGames, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameListItemViewModel">
                                    <Grid Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 48x48 Game Poster Thumbnail (高度与游戏名+时长+进度条总高度严格平齐) -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center" Background="#0C4F8FFF">
                                            <Grid>
                                                <Image Source="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill"
                                                       Visibility="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource NullToVisConverter}}" />
                                                <Viewbox Width="22" Height="22" Visibility="{x:Bind CoverPath, Mode=OneWay, Converter={StaticResource InverseNullToVisConverter}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                              Data="M 8 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 14 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 15.5 17 c 0 1 1.5 3 2 3 c 1.5 0 2.833 -1.667 3.5 -3 c 0.667 -1.667 0.5 -5.833 -1.5 -11.5 c -1.457 -1.015 -3 -1.34 -4.5 -1.5 l -0.972 1.923 a 11.913 11.913 0 0 0 -4.053 0 l -0.975 -1.923 c -1.5 0.16 -3.043 0.485 -4.5 1.5 c -2 5.667 -2.167 9.833 -1.5 11.5 c 0.667 1.333 2 3 3.5 3 c 0.5 0 2 -2 2 -3 M 7 16.5 c 3.5 1 6.5 1 10 0" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                        </Border>

                                        <!-- 右侧内容：游戏名（支持悬停跑马灯）、(时长 + 占比靠右)、进度条（调细 1/3，7px 高度圆角胶囊） -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <controls:MarqueeTextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <Grid>
                                                <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind PercentageText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <controls:RoundedProgressBar Value="{x:Bind ProgressPercentage, Mode=OneWay}"
                                                                         Maximum="100"
                                                                         Height="7"
                                                                         CornerRadius="3.5"
                                                                         Foreground="{ThemeResource ProgressBarGradientBrush}"
                                                                         Background="{ThemeResource CardBorderBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- 3. Consecutive Gaming Streak Achievement Card (Fixed Height 305px, Horizontal Layout) -->
                <Border Height="305"
                        CornerRadius="16"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource AccentPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 8 21 l 8 0 M 12 17 l 0 4 M 7 4 l 10 0 M 17 4 v 8 a 5 5 0 0 1 -10 0 v -8 M 5 9 m -2 0 a 2 2 0 1 0 4 0 a 2 2 0 1 0 -4 0 M 19 9 m -2 0 a 2 2 0 1 0 4 0 a 2 2 0 1 0 -4 0" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="连续游玩里程碑" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 成就体系 (Vertically Centered + Rich ToolTip) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#127C5CFC" CornerRadius="10" Padding="8,4">
                                <ToolTipService.ToolTip>
                                    <ToolTip Placement="Bottom" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                        <StackPanel Spacing="8" MaxWidth="280">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{ThemeResource AccentPurpleBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="连续游玩段位成就体系" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="保持每日游玩，按连续天数自动解锁对应段位称号：" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <MenuFlyoutSeparator Margin="-6,2,-6,2" />
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="🏆 Lv.5" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="传说的无伤通关者" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="6,0,0,0" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="≥ 53天" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="💎 Lv.4" FontSize="12" FontWeight="Bold" Foreground="#7C5CFC" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="全成就全收集狂人" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="6,0,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="31~52天" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="⭐ Lv.3" FontSize="12" FontWeight="Bold" Foreground="#4F8FFF" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="掌握彩蛋位置的知情人" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="6,0,0,0" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="16~30天" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="🌿 Lv.2" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="背包塞满草药的玩家" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="6,0,0,0" />
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="6~15天" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="🎮 Lv.1" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="愿望单收集家" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="6,0,0,0" />
                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="0~5天" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <TextBlock Text="成就体系" FontSize="12" Foreground="{ThemeResource AccentPurpleBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <!-- Middle: 左右结构 (勋章图标 on left, x天当前连续记录 on right) -->
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 勋章图标 -->
                            <Border Grid.Column="0" Width="76" Height="76" CornerRadius="38" Background="#124F8FFF" BorderBrush="#354F8FFF" BorderThickness="1.5" Margin="4,0,16,0">
                                <Image Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Source>
                                        <SvgImageSource UriSource="ms-appx:///Assets/achievements_completed.svg" RasterizePixelWidth="104" RasterizePixelHeight="104" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <!-- x天当前连续记录 (Tight alignment, no baseline gap) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.StreakDays, Mode=OneWay}" FontSize="38" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Bottom" />
                                    <TextBlock Text="天" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource AccentBlueBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                </StackPanel>
                                <TextBlock Text="当前连续记录" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="坚持每天游玩，点亮专属成就" FontSize="12" Foreground="{ThemeResource AccentPurpleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Bottom: Milestone Status Pill (Moved up 10px via Margin="0,-10,0,0") -->
                        <Border Grid.Row="2" Margin="0,-10,0,0" Background="#104F8FFF" BorderBrush="#254F8FFF" BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.NextMilestoneText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <controls:RoundedProgressBar Value="{x:Bind ViewModel.StreakDays, Mode=OneWay}" Maximum="{x:Bind ViewModel.NextMilestoneTarget, Mode=OneWay}" Height="8" CornerRadius="4" Foreground="{ThemeResource ProgressBarGradientBrush}" Background="{ThemeResource CardBorderBrush}" />
                                <!-- 当前段位。原先在右上角与「下一个里程碑」同排 ——
                                     2K/4K 下右列相对更窄，两段文字会挤在一起，所以挪到进度条下方。 -->
                                <TextBlock Text="{x:Bind ViewModel.StreakRankTitle, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentBlueBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
