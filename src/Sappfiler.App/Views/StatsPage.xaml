<Page
    x:Class="GameTimeTracker.App.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GameTimeTracker.App.ViewModels"
    xmlns:coreModels="using:GameTimeTracker.Core.Models"
    xmlns:coreServices="using:GameTimeTracker.Core.Services"
    xmlns:controls="using:GameTimeTracker.App.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,18,24,28">

            <!-- Top Header & Controls -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Title with Tabler Icon (No background box, matching title color) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- Tabler chart-bar icon -->
                            <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 3 12 h 4 v 8 h -4 z M 10 7 h 4 v 13 h -4 z M 17 3 h 4 v 17 h -4 z" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Spacing="2">
                        <TextBlock Text="游戏统计" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="查看你的游戏时长、偏好与趋势" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Period Switcher & Month Navigator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Period Tabs (Month / Quarter / Year) -->
                    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Click="OnMonthButtonClick" DoubleTapped="OnMonthButtonDoubleTapped"
                                    CornerRadius="6" Padding="12,5" BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsMonthSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                                    Foreground="{x:Bind ViewModel.IsMonthSelected, Mode=OneWay, Converter={StaticResource BoolToContrastTextBrushConverter}}"
                                    ToolTipService.ToolTip="单击切换月度，双击回到当前月份">
                                <TextBlock Text="月度" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                            <Button Click="OnQuarterButtonClick" DoubleTapped="OnQuarterButtonDoubleTapped"
                                    CornerRadius="6" Padding="12,5" BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsQuarterSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                                    Foreground="{x:Bind ViewModel.IsQuarterSelected, Mode=OneWay, Converter={StaticResource BoolToContrastTextBrushConverter}}"
                                    ToolTipService.ToolTip="单击切换季度，双击回到当前季度">
                                <TextBlock Text="季度" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                            <Button Click="OnYearButtonClick" DoubleTapped="OnYearButtonDoubleTapped"
                                    CornerRadius="6" Padding="12,5" BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsYearSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                                    Foreground="{x:Bind ViewModel.IsYearSelected, Mode=OneWay, Converter={StaticResource BoolToContrastTextBrushConverter}}"
                                    ToolTipService.ToolTip="单击切换年度，双击回到当前年份">
                                <TextBlock Text="年度" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Dedicated Period Navigator [‹ 2026年9月 ›] with Tabler Chevrons -->
                    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.PrevPeriodCommand}" Background="Transparent" BorderThickness="0" Padding="6,4" ToolTipService.ToolTip="上一周期">
                                <Viewbox Width="12" Height="12">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 15 6 l -6 6 l 6 6" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Grid Width="104" VerticalAlignment="Center" Margin="2,0" Background="Transparent"
                                  DoubleTapped="OnPeriodTitleDoubleTapped" ToolTipService.ToolTip="双击回到当前周期">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M 4 7 a 2 2 0 0 1 2 -2 h 12 a 2 2 0 0 1 2 2 v 12 a 2 2 0 0 1 -2 2 h -12 a 2 2 0 0 1 -2 -2 v -12 z M 16 3 v 4 M 8 3 v 4 M 4 11 h 16" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.PeriodTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Button Command="{x:Bind ViewModel.NextPeriodCommand}" Background="Transparent" BorderThickness="0" Padding="6,4" ToolTipService.ToolTip="下一周期">
                                <Viewbox Width="12" Height="12">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 9 6 l 6 6 l -6 6" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Row 1: 4 Metric Cards (Icons matching title font color, stacked delta as in Image 2) -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Total Playtime -->
                <Border Grid.Column="0" CornerRadius="14" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 2 6 a 2 2 0 0 1 2 -2 h 16 a 2 2 0 0 1 2 2 v 12 a 2 2 0 0 1 -2 2 h -16 a 2 2 0 0 1 -2 -2 z M 6 12 h 4 M 8 10 v 4 M 15 11 h 0.01 M 17 13 h 0.01" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="总游戏时长" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.TotalDurationText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{x:Bind ViewModel.TotalDeltaBrush, Mode=OneWay}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="{x:Bind ViewModel.TotalDeltaIconData, Mode=OneWay}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.TotalDeltaPercentText, Mode=OneWay}" Foreground="{x:Bind ViewModel.TotalDeltaBrush, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PeriodComparisonLabel, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Game Sessions Count -->
                <Border Grid.Column="1" CornerRadius="14" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 8 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 14 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 15.5 17 c 0 1 1.5 3 2 3 c 1.5 0 2.833 -1.667 3.5 -3 c 0.667 -1.667 0.5 -5.833 -1.5 -11.5 c -1.457 -1.015 -3 -1.34 -4.5 -1.5 l -0.972 1.923 a 11.913 11.913 0 0 0 -4.053 0 l -0.975 -1.923 c -1.5 0.16 -3.043 0.485 -4.5 1.5 c -2 5.667 -2.167 9.833 -1.5 11.5 c 0.667 1.333 2 3 3.5 3 c 0.5 0 2 -2 2 -3 M 7 16.5 c 3.5 1 6.5 1 10 0" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="游戏次数" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.TotalSessionsText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{x:Bind ViewModel.SessionsDeltaBrush, Mode=OneWay}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="{x:Bind ViewModel.SessionsDeltaIconData, Mode=OneWay}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.SessionsDeltaPercentText, Mode=OneWay}" Foreground="{x:Bind ViewModel.SessionsDeltaBrush, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PeriodComparisonLabel, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Daily Average Playtime -->
                <Border Grid.Column="2" CornerRadius="14" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 3 12 a 9 9 0 1 0 18 0 a 9 9 0 0 0 -18 0 M 12 7 v 5 l 3 3" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="平均每日时长" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.DailyAvgDurationText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{x:Bind ViewModel.DailyAvgDeltaBrush, Mode=OneWay}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="{x:Bind ViewModel.DailyAvgDeltaIconData, Mode=OneWay}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.DailyAvgDeltaPercentText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DailyAvgDeltaBrush, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PeriodComparisonLabel, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Most Played Game (With MarqueeTextBlock for long title) -->
                <Border Grid.Column="3" CornerRadius="14" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="18,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 12 17.75 l -6.172 3.245 l 1.179 -6.873 l -5 -4.867 l 6.9 -1 l 3.086 -6.253 l 3.086 6.253 l 6.9 1 l -5 4.867 l 1.179 6.873 z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="最常玩的游戏" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center" Background="#0C4F8FFF">
                                <Grid>
                                    <Image Source="{x:Bind ViewModel.TopGameCoverPath, Mode=OneWay, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill"
                                           Visibility="{x:Bind ViewModel.TopGameCoverPath, Mode=OneWay, Converter={StaticResource NullToVisConverter}}" />
                                    <Viewbox Width="18" Height="18" Visibility="{x:Bind ViewModel.TopGameCoverPath, Mode=OneWay, Converter={StaticResource InverseNullToVisConverter}}">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{ThemeResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M 8 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0 M 14 12 a 1 1 0 1 0 2 0 a 1 1 0 0 0 -2 0" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                <controls:MarqueeTextBlock Text="{x:Bind ViewModel.TopGameName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TopGameDurationText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind ViewModel.TopGamePercentageText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentBlueBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="总占比" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Middle Section (Distribution Donut + Daily Trend Line/Area) - Compact height, matching Image 1 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: 【游戏探索】 (Game Exploration) matching user mockup -->
                <Border Grid.Column="0" CornerRadius="16" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="18,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE735;" FontSize="16" Foreground="{ThemeResource AccentBlueBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="游戏探索" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="|" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Opacity="0.5" VerticalAlignment="Center" Margin="2,0" />
                            <TextBlock Text="{x:Bind ViewModel.ExplorationSubtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Donut + Category List Layout -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="142" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Donut Chart 150x150 (Shifted left 8px) -->
                            <Grid Grid.Column="0" Width="150" Height="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-8,0,0,0">
                                <Path Fill="{ThemeResource CardBorderBrush}" Opacity="0.3" Data="{x:Bind ViewModel.ExplorationTrackPath, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ExplorationDonutSlices, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DonutSliceViewModel">
                                            <Path Fill="{x:Bind ColorBrush}" Data="{x:Bind PathData}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Center Total Games Display -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="{x:Bind ViewModel.ExplorationTotalGamesCount, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="款游戏" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Categories List (Shifted left 8px to give right side more space) -->
                            <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.ExplorationCategories, Mode=OneWay}" VerticalAlignment="Center" Margin="4,0,0,0">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExplorationCategoryViewModel">
                                        <Grid Padding="0,5" Background="Transparent" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Icon -->
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="15" Foreground="{x:Bind ColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <!-- Title & Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Count & Percentage -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,10,0">
                                                <TextBlock Text="{x:Bind CountText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Text="{x:Bind PercentageText}" FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>

                                            <!-- Avatar Stack -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{x:Bind Avatars}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ExplorationAvatarItem">
                                                            <Border Width="22" Height="22" CornerRadius="11" Margin="{x:Bind Margin}" BorderBrush="{ThemeResource CardBackgroundBrush}" BorderThickness="1.5" Background="#154F8FFF">
                                                                <Grid>
                                                                    <Image Source="{x:Bind CoverPath, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill"
                                                                           Visibility="{x:Bind CoverPath, Converter={StaticResource NullToVisConverter}}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Period Delta badge (+2, -1, hidden when 0) -->
                                                <Border MinWidth="22" Height="18" Padding="5,0" CornerRadius="9" Background="{ThemeResource CardBorderBrush}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{x:Bind HasDelta, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{x:Bind DeltaText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Daily Playtime Trend Card -->
                <Border Grid.Column="1" CornerRadius="16" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="18,14">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M 3 3 v 18 h 18 M 20 9 l -6 6 l -4 -4 l -7 7" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="每日游戏时长趋势" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Toggle Switcher: [时长] [次数] -->
                            <Border HorizontalAlignment="Right" CornerRadius="6" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Command="{x:Bind ViewModel.SetTrendModeCommand}" CommandParameter="duration" CornerRadius="5" Padding="10,3" BorderThickness="0"
                                            Background="{x:Bind ViewModel.IsTrendDuration, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                                            Foreground="{x:Bind ViewModel.IsTrendDuration, Mode=OneWay, Converter={StaticResource BoolToContrastTextBrushConverter}}">
                                        <TextBlock Text="时长" FontSize="11" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.SetTrendModeCommand}" CommandParameter="sessions" CornerRadius="5" Padding="10,3" BorderThickness="0"
                                            Background="{x:Bind ViewModel.IsTrendSessions, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                                            Foreground="{x:Bind ViewModel.IsTrendSessions, Mode=OneWay, Converter={StaticResource BoolToContrastTextBrushConverter}}">
                                        <TextBlock Text="次数" FontSize="11" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Trend Chart View (Reduced compact height matching Image 1) -->
                        <Grid Height="160" SizeChanged="OnTrendChartSizeChanged">
                            <!-- Background Grid Lines & Y Axis Labels -->
                            <Grid VerticalAlignment="Stretch" Margin="0,10,0,22">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Top line -->
                                <Border Grid.Row="0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardBorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <TextBlock Text="{x:Bind ViewModel.TrendMaxText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" Margin="4,-7,0,0" />
                                </Border>
                                <!-- Mid line -->
                                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardBorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <TextBlock Text="{x:Bind ViewModel.TrendMidText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" Margin="4,-7,0,0" />
                                </Border>
                                <!-- Base line -->
                                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardBorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <TextBlock Text="{x:Bind ViewModel.TrendBaseText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" Margin="4,-7,0,0" />
                                </Border>
                            </Grid>

                            <!-- Today Vertical Dashed Guideline -->
                            <Line X1="{x:Bind ViewModel.TodayDotX, Mode=OneWay}"
                                  Y1="{x:Bind ViewModel.TodayDotY, Mode=OneWay}"
                                  X2="{x:Bind ViewModel.TodayDotX, Mode=OneWay}"
                                  Y2="{x:Bind ViewModel.ChartBaselineY, Mode=OneWay}"
                                  Stroke="{ThemeResource AccentBlueBrush}"
                                  StrokeDashArray="2,2"
                                  StrokeThickness="1"
                                  Opacity="0.4"
                                  Visibility="{x:Bind ViewModel.HasTodayPoint, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Gradient Area Fill -->
                            <Path Data="{x:Bind ViewModel.TrendAreaPathData, Mode=OneWay}">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#454F8FFF" Offset="0.0" />
                                        <GradientStop Color="#004F8FFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Trend Line Curve -->
                            <Path Data="{x:Bind ViewModel.TrendLinePathData, Mode=OneWay}" Stroke="{ThemeResource AccentBlueBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                            <!-- Interactive Trend Data Points (Hover Tooltip + Today Big Dot) -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TrendPointItems, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrendPointItemViewModel">
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="24" Height="24" Background="Transparent">
                                            <Grid.RenderTransform>
                                                <TranslateTransform X="{x:Bind TranslateX}" Y="{x:Bind TranslateY}" />
                                            </Grid.RenderTransform>
                                            <ToolTipService.ToolTip>
                                                <ToolTip Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{x:Bind FullDateTitle}" FontSize="11" Foreground="#94A3B8" />
                                                        <TextBlock Text="{x:Bind ValueText}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                                        <TextBlock Text="{x:Bind GameCountText}" FontSize="11" Foreground="#34D399" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>

                                            <!-- Normal Dot (when not today) -->
                                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{x:Bind IsToday, Converter={StaticResource InverseBoolToVisConverter}}" />

                                            <!-- Today Big Dot (Ring + inner dot matching media_1789887251664.png) -->
                                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{x:Bind IsToday, Converter={StaticResource BoolToVisConverter}}">
                                                <Ellipse Stroke="{ThemeResource AccentBlueBrush}" StrokeThickness="2.5" Fill="{ThemeResource CardBackgroundBrush}" />
                                                <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- X Axis Date Labels (Positioned exactly at each date tick: 9/1, 9/5, 9/10, 9/15, 9/20, 9/25, 9/30) -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TrendPointItems, Mode=OneWay}" VerticalAlignment="Bottom" Height="18" Margin="0,0,0,2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrendPointItemViewModel">
                                        <TextBlock Text="{x:Bind DateLabel}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}"
                                                   Visibility="{x:Bind HasDateLabel, Converter={StaticResource BoolToVisConverter}}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Width="36" TextAlignment="Center">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="{x:Bind LabelTranslateX}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: Bottom Section (Ranking + 【游戏类型分布】环形图 + Period Records) -->
            <!-- Columns: Rankings 1.12*, Genres 1.0*, Records 1.0* -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="1.0*" />
                    <ColumnDefinition Width="1.0*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Playtime Ranking (Top 6) -->
                <Border Grid.Column="0" CornerRadius="16" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{ThemeResource AccentPurpleBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 8 21 l 8 0 M 12 17 l 0 4 M 7 4 l 10 0 M 17 4 v 8 a 5 5 0 0 1 -10 0 v -8 M 5 9 m -2 0 a 2 2 0 1 0 4 0 a 2 2 0 1 0 -4 0 M 19 9 m -2 0 a 2 2 0 1 0 4 0 a 2 2 0 1 0 -4 0" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="游戏时长排行" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Ranked Games List (Top 6: Rank Badge + Cover + Name & Stats on top + Full-width Progress Bar below) -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.GameRankings, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="coreServices:GameStatItem">
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Rank Badge (1=Gold, 2=Silver, 3=Bronze, 4+=Normal) -->
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Background="{x:Bind Rank, Converter={StaticResource RankToBadgeBrushConverter}}">
                                            <TextBlock Text="{x:Bind Rank}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{x:Bind Rank, Converter={StaticResource RankToTextBrushConverter}}" />
                                        </Border>

                                        <!-- Cover Thumbnail -->
                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Margin="0,0,9,0" VerticalAlignment="Center" Background="#0C4F8FFF">
                                            <Grid>
                                                <Image Source="{x:Bind CoverPath, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill"
                                                       Visibility="{x:Bind CoverPath, Converter={StaticResource NullToVisConverter}}" />
                                            </Grid>
                                        </Border>

                                        <!-- Right Content: Top Row (Name + Duration + Pct), Bottom Row (Full-width Progress Bar) -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Top Row: Game Name (Marquee) on left, Duration & Percentage on right -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <controls:MarqueeTextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                           ToolTipService.ToolTip="{x:Bind Name}" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DurationText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind PercentageText}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Bottom Row: Full-width Progress Bar stretching all the way across -->
                                            <controls:RoundedProgressBar Grid.Row="1" Value="{x:Bind RatioToMax}" Maximum="1.0" Height="4" CornerRadius="2" Margin="0,4,0,0"
                                                                         Foreground="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="{ThemeResource CardBorderBrush}" HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- 2. 【游戏时长分布】 (Playtime Tier Distribution) -->
                <Border Grid.Column="1" CornerRadius="16" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 12 12 m -9 0 a 9 9 0 1 0 18 0 a 9 9 0 1 0 -18 0 M 12 7 v 5 l 3 3" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="游戏时长分布" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Top: Donut Chart (150x150px) -->
                        <Grid Width="150" Height="150" HorizontalAlignment="Center" Margin="0,2,0,4">
                            <Path Fill="{ThemeResource CardBorderBrush}" Opacity="0.3" Data="{x:Bind ViewModel.TierTrackPath, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PlaytimeTierDonutSlices, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DonutSliceViewModel">
                                        <Path Fill="{x:Bind ColorBrush}" Data="{x:Bind PathData}" ToolTipService.ToolTip="{x:Bind Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Center Total Games Display -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{x:Bind ViewModel.TierTotalGamesCount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="总游戏数" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Bottom: Legend (2 Columns x 3 Rows, 6 Tiers spanning from 最左 to 最右) -->
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: 0-2h, 10-50h, 100-500h -->
                            <ItemsRepeater Grid.Column="0" ItemsSource="{x:Bind ViewModel.LeftPlaytimeTiers, Mode=OneWay}" HorizontalAlignment="Stretch">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlaytimeTierViewModel">
                                        <Grid HorizontalAlignment="Stretch" Padding="0,3" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Dot + TierName on Left -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{x:Bind ColorBrush}" VerticalAlignment="Center" Margin="0,0,1,0" />
                                                <TextBlock Text="{x:Bind TierName}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" TextTrimming="None" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                            <!-- Percentage & Count on Right (shifted left by 10px) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{x:Bind Percentage}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Text="{x:Bind CountText}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Right Column: 2-10h, 50-100h, 500h+ -->
                            <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.RightPlaytimeTiers, Mode=OneWay}" HorizontalAlignment="Stretch">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlaytimeTierViewModel">
                                        <Grid HorizontalAlignment="Stretch" Padding="0,3" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Dot + TierName on Left (shifted right by 10px) -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Ellipse Width="7" Height="7" Fill="{x:Bind ColorBrush}" VerticalAlignment="Center" Margin="0,0,1,0" />
                                                <TextBlock Text="{x:Bind TierName}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" TextTrimming="None" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                            <!-- Percentage & Count on Right -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Percentage}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Text="{x:Bind CountText}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. 【游戏活跃度】 (Game Activity) -->
                <Border Grid.Column="2" CornerRadius="16" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{ThemeResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 4 7 a 2 2 0 0 1 2 -2 h 12 a 2 2 0 0 1 2 2 v 12 a 2 2 0 0 1 -2 2 h -12 a 2 2 0 0 1 -2 -2 v -12 z M 16 3 v 4 M 8 3 v 4 M 4 11 h 16" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{x:Bind ViewModel.GameActivityCardTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Games Activity List: Cover + Name on Row 0 + Full-width Progress Bar on Row 1 + Subtitle on Row 2 (No rank medals) -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.GameActivities, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="coreModels:GameActivityItem">
                                    <Grid Padding="0,3.5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover Thumbnail -->
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Margin="0,0,9,0" VerticalAlignment="Center" Background="#0C4F8FFF">
                                            <Grid>
                                                <Image Source="{x:Bind CoverPath, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill"
                                                       Visibility="{x:Bind CoverPath, Converter={StaticResource NullToVisConverter}}" />
                                            </Grid>
                                        </Border>

                                        <!-- Right Content: Row 0 Name, Row 1 Full-width Progress Bar, Row 2 Active days + Last played -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Game Name (Marquee) -->
                                            <controls:MarqueeTextBlock Grid.Row="0" Text="{x:Bind Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       ToolTipService.ToolTip="{x:Bind Name}" />

                                            <!-- Row 1: Full-width Progress Bar stretching all the way across -->
                                            <controls:RoundedProgressBar Grid.Row="1" Value="{x:Bind RatioToMax}" Maximum="1.0" Height="4" CornerRadius="2" Margin="0,4,0,3"
                                                                         Foreground="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="{ThemeResource CardBorderBrush}" HorizontalAlignment="Stretch" />

                                            <!-- Row 2: Subtitle e.g. "12 个游玩日 · 最近今天" -->
                                            <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,0">
                                                <Run Text="{x:Bind ActiveDays}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                                <Run Text=" 个游玩日 · " />
                                                <Run Text="{x:Bind LastPlayedText}" />
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
