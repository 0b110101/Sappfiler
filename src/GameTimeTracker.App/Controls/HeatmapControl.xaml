<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GameTimeTracker.App.Controls.HeatmapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <!-- Main Heatmap Area: Weekday Labels (一、三、五) + Scrollable 52-Week Matrix -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Weekday Labels (Only 一, 三, 五 on rows 1, 3, 5) -->
            <Grid Grid.Column="0" Margin="0,22,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Text="一" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="3" Text="三" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="5" Text="五" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>

            <!-- Scrollable Year Heatmap Matrix -->
            <ScrollViewer x:Name="HeatmapScroll" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Disabled">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <!-- Month Header Row -->
                    <Grid x:Name="MonthHeaderGrid" Height="18" />

                    <!-- 7 x 52 Heatmap Matrix Grid -->
                    <Grid x:Name="MatrixGrid" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Legend -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4" Margin="0,2,0,0">
            <TextBlock Text="少" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
            <Border Width="11" Height="11" CornerRadius="3" Background="{ThemeResource HeatmapLevel0Brush}" BorderBrush="{ThemeResource HeatmapLevel0BorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
            <Border Width="11" Height="11" CornerRadius="3" Background="{ThemeResource HeatmapLevel1Brush}" BorderThickness="0" VerticalAlignment="Center" />
            <Border Width="11" Height="11" CornerRadius="3" Background="{ThemeResource HeatmapLevel2Brush}" BorderThickness="0" VerticalAlignment="Center" />
            <Border Width="11" Height="11" CornerRadius="3" Background="{ThemeResource HeatmapLevel3Brush}" BorderThickness="0" VerticalAlignment="Center" />
            <Border Width="11" Height="11" CornerRadius="3" Background="{ThemeResource HeatmapLevel4Brush}" BorderThickness="0" VerticalAlignment="Center" />
            <Border Width="11" Height="11" CornerRadius="3" Background="{ThemeResource HeatmapLevel5Brush}" BorderThickness="0" VerticalAlignment="Center" />
            <TextBlock Text="多" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
