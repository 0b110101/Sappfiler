<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GameTimeTracker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GameTime Tracker"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootWindowGrid" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="GameTime Tracker">
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <BitmapImage UriSource="ms-appx:///Assets/logo.png" DecodePixelWidth="32" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Main Body Grid: 220px Sidebar + Content Frame -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 220px Left Sidebar -->
            <Border Grid.Column="0"
                    Background="{ThemeResource SidebarBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,20,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="4,0,0,24">
                        <Border Width="32" Height="32" CornerRadius="8" Background="Transparent">
                            <Image Width="32" Height="32" Source="ms-appx:///Assets/logo.png" />
                        </Border>
                        <TextBlock Text="GameTime Tracker" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <!-- 今日 (Active Tab) -->
                        <Border x:Name="NavHomeBtn" Tag="Home"
                                Tapped="OnNavHomeClicked"
                                PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource NavActiveBrush}"
                                CornerRadius="10" Padding="10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavHomeIndicator" Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{ThemeResource AccentBlueBrush}" Margin="-2,0,10,0" Visibility="Visible" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon x:Name="NavHomeIcon" Glyph="&#xE80F;" FontSize="16" Foreground="{ThemeResource AccentBlueBrush}" />
                                    <TextBlock x:Name="NavHomeText" Text="今日" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 历史 -->
                        <Border x:Name="NavHistoryBtn" Tag="History"
                                Tapped="OnNavHistoryClicked"
                                PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"
                                HorizontalAlignment="Stretch"
                                Background="Transparent" CornerRadius="10" Padding="10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavHistoryIndicator" Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{ThemeResource AccentBlueBrush}" Margin="-2,0,10,0" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon x:Name="NavHistoryIcon" Glyph="&#xE81C;" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="NavHistoryText" Text="历史" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 待处理 (With Badge) -->
                        <Border x:Name="NavPendingBtn" Tag="Pending"
                                Tapped="OnNavPendingClicked"
                                PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"
                                HorizontalAlignment="Stretch"
                                Background="Transparent" CornerRadius="10" Padding="10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavPendingIndicator" Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{ThemeResource AccentBlueBrush}" Margin="-2,0,10,0" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon x:Name="NavPendingIcon" Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="NavPendingText" Text="待处理" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Border x:Name="PendingBadgeBorder" Grid.Column="2" Background="{ThemeResource StatusRedBrush}"
                                        CornerRadius="10" Width="20" Height="20" Padding="0"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <!-- Grid 双向居中；-2px 是数字字形的光学居中补偿：
                                         11px 的行框在基线下方留有降部空隙，不补偿会整体偏低 -->
                                    <Grid>
                                        <TextBlock x:Name="PendingBadgeText" Text="0" FontSize="11" FontWeight="Bold"
                                                   Foreground="White" Margin="0,-2,0,0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 游戏映射 -->
                        <Border x:Name="NavMappingsBtn" Tag="Mappings"
                                Tapped="OnNavMappingsClicked"
                                PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"
                                HorizontalAlignment="Stretch"
                                Background="Transparent" CornerRadius="10" Padding="10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavMappingsIndicator" Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{ThemeResource AccentBlueBrush}" Margin="-2,0,10,0" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon x:Name="NavMappingsIcon" Glyph="&#xE71B;" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="NavMappingsText" Text="游戏映射" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 设置 -->
                        <Border x:Name="NavSettingsBtn" Tag="Settings"
                                Tapped="OnNavSettingsClicked"
                                PointerEntered="OnNavPointerEntered" PointerExited="OnNavPointerExited"
                                HorizontalAlignment="Stretch"
                                Background="Transparent" CornerRadius="10" Padding="10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavSettingsIndicator" Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{ThemeResource AccentBlueBrush}" Margin="-2,0,10,0" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon x:Name="NavSettingsIcon" Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="NavSettingsText" Text="设置" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Actions & Status Capsule -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <!-- 1. 手动添加游戏 -->
                        <Button x:Name="ManualAddGameBtn"
                                Click="OnManualAddGameClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource AccentBlueBrush}" />
                                    <TextBlock Text="添加游戏" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 2. 打开 Notion -->
                        <Button x:Name="OpenNotionBtn"
                                Click="OnOpenNotionClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{ThemeResource AccentPurpleBrush}" />
                                    <TextBlock Text="打开 Notion" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 3. Notion 同步状态 Capsule -->
                        <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Padding="12,10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource StatusGreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SidebarNotionStatus" Text="Notion 已同步" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="SidebarNotionTime" Text="上次同步 10:24" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" Margin="14,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Frame -->
            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
