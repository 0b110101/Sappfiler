<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameTimeTracker.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GameTimeTracker.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" HorizontalAlignment="Stretch">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="游玩历史明细" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="查看所有历史游戏记录及每日统计" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Table Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="16,14">
                <StackPanel Spacing="6">
                    <!-- Column Header -->
                    <Grid Padding="12,10" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="2.5*" MinWidth="180" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日期" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="游戏名称" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="所属平台" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="游玩时长" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="同步状态" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="" FontSize="13" />
                    </Grid>

                    <!-- Items List (Using ItemsRepeater for exact pixel alignment without ListViewItem margins) -->
                    <ItemsRepeater x:Name="HistoryRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentRecordViewModel">
                                <Border BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,0.5">
                                    <Grid Padding="12,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="2.5*" MinWidth="180" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind DateText}" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0">
                                                <Image Source="{x:Bind CoverPath, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill"
                                                       Visibility="{x:Bind CoverPath, Converter={StaticResource NullToVisConverter}}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind GameName}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Border Grid.Column="2" HorizontalAlignment="Left" Background="#154F8FFF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Platform}" FontSize="12" Foreground="{ThemeResource AccentBlueBrush}" FontWeight="Medium" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind StatusText}" FontSize="13" Foreground="{x:Bind StatusBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="5" Tag="{x:Bind}" Click="OnDeleteRecordClicked"
                                                ToolTipService.ToolTip="删除这条记录（同时归档 Notion 上的对应页面）"
                                                Background="Transparent" BorderThickness="0" Padding="6,4"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource StatusRedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
