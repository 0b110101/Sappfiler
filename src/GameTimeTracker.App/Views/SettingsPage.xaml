<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameTimeTracker.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="应用程序设置" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="配置 Notion API 凭证、数据库 ID 以及监控轮询参数" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Test Connection InfoBar -->
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Appearance & System Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="系统与外观" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />

                    <!-- 开机自启动 (默认关闭) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="开机自启动" FontSize="15" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="开机登录后自动在后台托盘静默运行，无需手动启动（默认关闭）" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" Toggled="OnAutoStartToggled" OnContent="已开启" OffContent="已关闭" />
                    </Grid>

                    <Border Background="{ThemeResource CardBorderBrush}" Opacity="0.35" Height="1" />

                    <!-- 深色模式 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="深色模式 (Dark Theme)" FontSize="15" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="切换专属深色星空主题" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ThemeToggle" Grid.Column="1" Toggled="OnThemeToggled" OnContent="已开启" OffContent="已关闭" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notion Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="Notion 同步配置" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />

                    <PasswordBox x:Name="TokenInput" Header="Notion Token" PlaceholderText="secret_xxxxxxxxxxxxxxxx"
                                 MaxWidth="520" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="GameDbInput" Header="游戏总表 Database ID" PlaceholderText="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                             MaxWidth="520" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="DailyDbInput" Header="每日时长表 Database ID" PlaceholderText="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                             MaxWidth="520" HorizontalAlignment="Stretch" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="SaveBtn" Click="OnSaveClicked" Content="保存设置" CornerRadius="8" Background="{ThemeResource AccentBlueBrush}" Foreground="White" Padding="16,8" />
                        <Button x:Name="TestBtn" Click="OnTestConnectionClicked" Content="测试连接" CornerRadius="8" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Daily Cutoff Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="跨日时间戳设置" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="设定每日游戏时长的归属结算点。适合习惯深夜游玩的用户，避免凌晨游戏记录被割裂到次日。"
                               FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="每日跨日结算时间点 (整点)" FontSize="15" FontWeight="Medium" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="在该时刻之前游玩的时间均归属于前一日" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="CutoffHourCombo" Grid.Column="1" MinWidth="220" SelectionChanged="OnCutoffHourChanged">
                            <ComboBoxItem Content="24:00 (次日 00:00 - 标准跨日)" Tag="24" />
                            <ComboBoxItem Content="25:00 (次日 01:00)" Tag="25" />
                            <ComboBoxItem Content="26:00 (次日 02:00)" Tag="26" />
                            <ComboBoxItem Content="27:00 (次日 03:00)" Tag="27" />
                            <ComboBoxItem Content="28:00 (次日 04:00 - 深夜玩家推荐)" Tag="28" />
                            <ComboBoxItem Content="29:00 (次日 05:00)" Tag="29" />
                            <ComboBoxItem Content="30:00 (次日 06:00)" Tag="30" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tracker Performance Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="后台监控与同步策略" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="进程轮询心跳: 5 秒 (极低 CPU 消耗)" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="Notion 同步策略: 应用启动时自动同步、游戏退出时自动同步 (无游戏时不空转轮询)" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="本地数据库: SQLite WAL 高性能模式" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="系统托盘: 点击右上角 × 关闭按钮自动最小化至托盘" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Storage Location Card -->
            <Border CornerRadius="14"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="存档位置" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="数据库与封面缓存的存放位置。更改后自动把现有数据复制到新位置，重启程序生效。" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Border Background="{ThemeResource CardBorderBrush}" Opacity="0.35" Height="1" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StoragePathText" Grid.Column="0" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Consolas" />
                        <Button x:Name="ChangeStorageBtn" Grid.Column="1" Content="更改…" CornerRadius="8" Padding="14,6"
                                Margin="12,0,0,0" Click="OnChangeStorageClicked" />
                        <Button x:Name="ResetStorageBtn" Grid.Column="2" Content="恢复默认" CornerRadius="8" Padding="14,6"
                                Margin="8,0,0,0" Click="OnResetStorageClicked" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Version footer -->
            <TextBlock x:Name="VersionText"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,8"
                       FontSize="12"
                       Foreground="{ThemeResource TextSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
