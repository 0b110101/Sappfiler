<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GameTimeTracker.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:GameTimeTracker.App.Converters"
    xmlns:local="using:GameTimeTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <!-- Light Theme Resources -->
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F9" />
                            <SolidColorBrush x:Key="HeatmapLevel0Brush" Color="#F1F6FC" />
                            <SolidColorBrush x:Key="HeatmapLevel0BorderBrush" Color="#E5E9F0" />
                            <SolidColorBrush x:Key="HeatmapLevel1Brush" Color="#DCEBFA" />
                            <SolidColorBrush x:Key="HeatmapLevel2Brush" Color="#BFD9F5" />
                            <SolidColorBrush x:Key="HeatmapLevel3Brush" Color="#8CB9F0" />
                            <SolidColorBrush x:Key="HeatmapLevel4Brush" Color="#4F8FE8" />
                            <SolidColorBrush x:Key="HeatmapLevel5Brush" Color="#2563D9" />
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" Opacity="0.88" />
                            <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E9F0" />
                            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
                            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
                            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F8FAFC" Opacity="0.75" />
                            <SolidColorBrush x:Key="NavHoverBrush" Color="#E2E8F0" />
                            <SolidColorBrush x:Key="NavActiveBrush" Color="#E5EDF8" />
                            <SolidColorBrush x:Key="AccentBlueBrush" Color="#4F8FFF" />
                            <SolidColorBrush x:Key="AccentPurpleBrush" Color="#7C5CFC" />
                            <LinearGradientBrush x:Key="ProgressBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4F8FFF" Offset="0.0" />
                                <GradientStop Color="#2563D9" Offset="1.0" />
                            </LinearGradientBrush>
                        </ResourceDictionary>

                        <!-- Dark Theme Resources -->
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1B2E" />
                            <SolidColorBrush x:Key="HeatmapLevel0Brush" Color="#2A2D45" />
                            <SolidColorBrush x:Key="HeatmapLevel0BorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="HeatmapLevel1Brush" Color="#3C3E5F" />
                            <SolidColorBrush x:Key="HeatmapLevel2Brush" Color="#606187" />
                            <SolidColorBrush x:Key="HeatmapLevel3Brush" Color="#8485AF" />
                            <SolidColorBrush x:Key="HeatmapLevel4Brush" Color="#A8A8D7" />
                            <SolidColorBrush x:Key="HeatmapLevel5Brush" Color="#CCCCFF" />
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#212338" Opacity="0.92" />
                            <SolidColorBrush x:Key="CardBorderBrush" Color="#2D3050" />
                            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#CCCCFF" />
                            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9999BB" />
                            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A1B2E" Opacity="0.95" />
                            <SolidColorBrush x:Key="NavHoverBrush" Color="#252744" />
                            <SolidColorBrush x:Key="NavActiveBrush" Color="#2A2D4E" />
                            <SolidColorBrush x:Key="AccentBlueBrush" Color="#CCCCFF" />
                            <SolidColorBrush x:Key="AccentPurpleBrush" Color="#9999FF" />
                            <LinearGradientBrush x:Key="ProgressBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#CCCCFF" Offset="0.0" />
                                <GradientStop Color="#9999FF" Offset="1.0" />
                            </LinearGradientBrush>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <!-- Common Status Brushes -->
                    <SolidColorBrush x:Key="StatusGreenBrush" Color="#34D399" />
                    <SolidColorBrush x:Key="StatusOrangeBrush" Color="#FB923C" />
                    <SolidColorBrush x:Key="StatusRedBrush" Color="#F87171" />

                    <!-- Converters -->
                    <converters:HeatmapLevelToBrushConverter x:Key="LevelToBrushConverter" />
                    <converters:StringToImageSourceConverter x:Key="StringToImageConverter" />
                    <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
                    <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
                    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
                    <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
                    <converters:NullToVisibilityConverter x:Key="InverseNullToVisConverter" Invert="True" />
                    <converters:BoolToAccentBrushConverter x:Key="BoolToAccentBrushConverter" />
                    <converters:BoolToContrastTextBrushConverter x:Key="BoolToContrastTextBrushConverter" />
                    <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
                    <converters:RankToBadgeBrushConverter x:Key="RankToBadgeBrushConverter" />
                    <converters:RankToTextBrushConverter x:Key="RankToTextBrushConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
